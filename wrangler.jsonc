{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-founders-hq",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  // The custom domain is currently attached in the Cloudflare dashboard.
  // Add a routes entry only if recreating that binding after confirming zone state:
  // "routes": [{ "pattern": "futurefoundershq.org", "custom_domain": true }]
  // Configure www -> apex using a Cloudflare Redirect Rule (DEPLOYMENT.md).
}
